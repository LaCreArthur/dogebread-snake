{
  // Worker side: workerd runtime types come from worker-configuration.d.ts (npm run types), no DOM
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [".", "../game", "../../worker-configuration.d.ts"]
}
